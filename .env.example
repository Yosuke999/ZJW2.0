# Supabase project values. Keep real credentials in .env.local and Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Use the Supabase transaction pooler connection string for Vercel.
DATABASE_URL=postgresql://postgres.project-ref:password@host:6543/postgres

# Gemini server-side customer support. Add the real value in Vercel Environment Variables.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
